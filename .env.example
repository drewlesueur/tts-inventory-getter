PORT=8080
SERVICE_KEY=replace-with-strong-key
ENABLE_HMAC=false
HMAC_SECRET=replace-with-shared-secret
REQUEST_BODY_LIMIT_MB=2
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
SQLITE_PATH=data/scraper_results.db
SITE_CONFIGS_DIR=configs/sites
DEFAULT_RUN_TIMEOUT_SEC=600
SCRAPE_CONCURRENCY=4
SCRAPE_MAX_ATTEMPTS=3
SCRAPE_RETRY_BACKOFF_SEC=2
HTTP_FETCH_TIMEOUT_SEC=25
ENABLE_IMAGE_UPDATE_CRON=false
IMAGE_UPDATE_CRON_SPEC=0 0 */2 * * *
ENABLE_DAILY_UPSERT_CRON=false
DAILY_UPSERT_CRON_SPEC=@daily
ENABLE_IDEMPOTENCY_CLEAR_CRON=false
IDEMPOTENCY_CLEAR_CRON_SPEC=@daily
INVENTORY_API_BASE_URL=http://localhost
ERROR_LOG_PATH=data/errors.log
CHROME_HEADLESS=true
ALLOW_MAIN_DB_WRITE=false

# Codex/OpenAI discovery mode
ENABLE_CODEX_DISCOVERY=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
