PORT=8080
SERVICE_KEY=replace-with-strong-key
ENABLE_HMAC=false
HMAC_SECRET=replace-with-shared-secret
REQUEST_BODY_LIMIT_MB=2
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
SQLITE_PATH=data/scraper_results.db
SITE_CONFIGS_DIR=configs/sites
DEFAULT_RUN_TIMEOUT_SEC=600
SCRAPE_CONCURRENCY=4
SCRAPE_MAX_ATTEMPTS=3
SCRAPE_RETRY_BACKOFF_SEC=2
HTTP_FETCH_TIMEOUT_SEC=25
ENABLE_DAILY_UPSERT_CRON=false
DAILY_UPSERT_CRON_SPEC=@daily
ENABLE_WEEKLY_UPSERT_CRON=false
WEEKLY_UPSERT_CRON_SPEC=0 0 2 * * 0
ENABLE_IDEMPOTENCY_CLEAR_CRON=false
IDEMPOTENCY_CLEAR_CRON_SPEC=@daily
INVENTORY_API_BASE_URL=http://localhost
ERROR_LOG_PATH=data/errors.log
CHROME_HEADLESS=true
ALLOW_MAIN_DB_WRITE=false

# Codex/OpenAI discovery mode
ENABLE_CODEX_DISCOVERY=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Residential proxy for DataDome bypass on cloud servers
# Format: http://user:pass@host:port  or  socks5://user:pass@host:port
# Needed when server IP is a datacenter IP that DataDome blocks.
# Providers: Bright Data, Oxylabs, IPRoyal, Webshare (~$3-5/GB)
SCRAPER_PROXY=

# Python curl_cffi fetcher (better TLS fingerprint than Go's TLS client)
# Set PYTHON_BIN to the python binary that has curl_cffi installed
# Leave FETCH_SCRIPT_PATH empty to use Go's built-in TLS client instead
PYTHON_BIN=python3
FETCH_SCRIPT_PATH=scripts/fetch_page.py
DETAIL_SCRIPT_PATH=scripts/fetch_details.py

CACHE_ONLY_URLS=https://www.saiautosale.com/cars-for-sale
